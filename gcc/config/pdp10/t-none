# DAIMOS/PDP-10 bare target make fragment.
#
# Build libgcc for the oldest useful baseline.  pdp10-dec-none must not
# inherit TOPS-20/PIC/libc assumptions: early DAIMOS has no target libc,
# no real dynamic loader, and PDP-6/166-safe code should run upward on
# later PDP-10-class machines.

TARGET_LIBGCC2_CFLAGS = -fomit-frame-pointer -DUNDERSCORE=__ -Dinhibit_libc -march=base -mtune=166 -munextended -mno-string -mlong-long-71bit
LIBGCC2_DEBUG_CFLAGS = -g0

# PDP-10-specific SF/DF conversions and comparisons are supplied by
# libgcc1.s.  Keep the generic double-word conversion entry points needed
# by GCC-built native programs: __fixdfdi, __fixunsdfdi, __fixunsdfsi,
# __floatdisf and __floatdidf.
# Other unsupported hosted conversions remain excluded.
LIB2FUNCS_EXCLUDE = _fixunssfsi _exit _eprintf \
  _bb _fixunssfdi _fixsfdi _fixxfdi _fixunsxfdi _floatdixf \
  _fixunsxfsi _fixtfdi _fixunstfdi _floatditf __main _trampoline _divdi3 _moddi3 \
  _udivdi3 _umoddi3 _udivmoddi4 _udivsi3 _umodsi3

# __eprintf is guarded by !inhibit_libc in libgcc2.c, so it emits an
# intentionally empty translation unit for this freestanding target.


# The DImode division/modulo helpers are supplied by libgcc1.s.
# GCC 3.2's generic libgcc2 implementations lower through unsigned SImode
# helpers such as __umodsi3 before the bare PDP-10 runtime archive has been
# assembled, and the current deposit-script assembler intentionally rejects
# undefined symbols in word expressions.  Use the PDP-10 assembly helpers
# directly instead of building the hosted generic libgcc2 variants.  Exclude
# _udivmoddi4 too: even when the public div/mod helpers are excluded, libgcc2
# still builds the standalone unsigned DImode core object unless it is named
# explicitly here.  Exclude the generic unsigned SImode helpers too, because
# the PDP-10 libgcc1 helper set provides public __udivsi3/__umodsi3 symbols.

# libgcc2.c __main assumes hosted EH/ctor frame registration.  The bare
# PDP-10 runtime supplies a no-op __main in libgcc1.s instead.

# libgcc2.c emits L_exit only when NEED_ATEXIT is defined.  The freestanding
# PDP-10 target does not define it, so requesting _exit produces an empty
# assembly file, which DAS correctly refuses as an empty image.

# Build the freestanding PDP-10 runtime through GCC's classic per-function
# libgcc1 mechanism.  Canonical GCC helper names are separate DOBJ members;
# DARC/DLINK provide normal archive extraction, so helpers no longer need
# bare-only ownership names merely to avoid local-label collisions.
LIB1ASMSRC = pdp10/libgcc1.s
LIB1ASMFUNCS = _main _divdi3 _udivsi3 _umodsi3 _fixsfsi _fixdfsi \
	_floatsisf _floatsidf _floatunssisf _cmpdf2 \
	BADL6 BADL7 BADL8 BADL9 BADLH BADX6 BADX7 BADX8 BADXH

# DAS does not recognize GNU assembler-style CPP line markers.
# Suppress them only for preprocessed libgcc assembly sources.
LIB1ASM_CFLAGS = -Wp,-P -DPDP10_DOBJ
LIB2ASM_CFLAGS = -Wp,-P

# Provide a real public abort symbol for freestanding pdp10-dec-none users.
LIB2FUNCS_EXTRA = $(srcdir)/config/pdp10/abort.asm \
	$(srcdir)/config/pdp10/pdp10-softdf.c \
	$(srcdir)/config/pdp10/pdp10-softdf-neg.c \
	$(srcdir)/config/pdp10/pdp10-softdf-mul.c \
	$(srcdir)/config/pdp10/pdp10-softdf-div.c

# DOBJ objects are archived directly as DARC1.  DARC carries its symbol index
# by construction, so there is no target ranlib pass.
AR_CREATE_FOR_TARGET = pdp10-dec-none-darc -o
RANLIB_TEST_FOR_TARGET = false

# No EH unwinder objects for the C-only bare target yet.
LIB2ADDEH =
LIB2ADDEHDEP =
