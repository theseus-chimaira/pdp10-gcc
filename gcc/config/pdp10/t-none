# DAIMOS/PDP-10 bare target make fragment.
#
# Build libgcc for the oldest useful baseline.  pdp10-dec-none must not
# inherit TOPS-20/PIC/libc assumptions: early DAIMOS has no target libc,
# no real dynamic loader, and PDP-6/166-safe code should run upward on
# later PDP-10-class machines.

TARGET_LIBGCC2_CFLAGS = -fomit-frame-pointer -DUNDERSCORE=. -Dinhibit_libc -march=166 -mtune=166 -munextended -mno-string -mlong-long-71bit
LIBGCC2_DEBUG_CFLAGS = -g0

# Early DAIMOS baseline has no floating-point runtime yet.  Do not build
# libgcc2 floating conversion helpers; they would require target FP codegen
# and assembler FP opcode support which are deliberately deferred.
LIB2FUNCS_EXCLUDE = _floatdidf _floatdisf _fixunsdfsi _fixunssfsi \
  _fixunsdfdi _fixdfdi _fixunssfdi _fixsfdi _fixxfdi _fixunsxfdi \
  _floatdixf _fixunsxfsi _fixtfdi _fixunstfdi _floatditf __main \
  _divdi3 _moddi3 _udivdi3 _umoddi3 _udivmoddi4


# The DImode division/modulo helpers are also supplied by libgcc-pdp10.s.
# GCC 3.2's generic libgcc2 implementations lower through unsigned SImode
# helpers such as __umodsi3 before the bare PDP-10 runtime archive has been
# assembled, and the current deposit-script assembler intentionally rejects
# undefined symbols in word expressions.  Use the PDP-10 assembly helpers
# directly instead of building the hosted generic libgcc2 variants.  Exclude
# _udivmoddi4 too: even when the public div/mod helpers are excluded, libgcc2
# still builds the standalone unsigned DImode core object unless it is named
# explicitly here.

# libgcc2.c __main assumes hosted EH/ctor frame registration.  The bare
# PDP-10 runtime supplies a no-op __main in libgcc-pdp10.s instead.

# Provide a real public abort symbol for freestanding pdp10-dec-none users.
LIB2FUNCS_EXTRA = $(srcdir)/config/pdp10/abort.asm \
  $(srcdir)/config/pdp10/libgcc-pdp10.s

# No EH unwinder objects for the C-only bare target yet.
LIB2ADDEH =
LIB2ADDEHDEP =
