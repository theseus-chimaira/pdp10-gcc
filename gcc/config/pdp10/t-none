# DAIMOS/PDP-10 bare target make fragment.
#
# Build libgcc for the oldest useful baseline.  pdp10-dec-none must not
# inherit TOPS-20/PIC/libc assumptions: early DAIMOS has no target libc,
# no real dynamic loader, and PDP-6/166-safe code should run upward on
# later PDP-10-class machines.

TARGET_LIBGCC2_CFLAGS = -fomit-frame-pointer -DUNDERSCORE=. -Dinhibit_libc -march=base -mtune=166 -munextended -mno-string -mlong-long-71bit
LIBGCC2_DEBUG_CFLAGS = -g0

# Early DAIMOS baseline has no floating-point runtime yet.  Do not build
# libgcc2 floating conversion helpers; they would require target FP codegen
# and assembler FP opcode support which are deliberately deferred.
LIB2FUNCS_EXCLUDE = _floatdidf _floatdisf _fixunsdfsi _fixunssfsi _exit \
  _fixunsdfdi _fixdfdi _fixunssfdi _fixsfdi _fixxfdi _fixunsxfdi \
  _floatdixf _fixunsxfsi _fixtfdi _fixunstfdi _floatditf __main _trampoline \
  _divdi3 _moddi3 _udivdi3 _umoddi3 _udivmoddi4 _udivsi3 _umodsi3


# The DImode division/modulo helpers are supplied by libgcc1.s.
# GCC 3.2's generic libgcc2 implementations lower through unsigned SImode
# helpers such as __umodsi3 before the bare PDP-10 runtime archive has been
# assembled, and the current deposit-script assembler intentionally rejects
# undefined symbols in word expressions.  Use the PDP-10 assembly helpers
# directly instead of building the hosted generic libgcc2 variants.  Exclude
# _udivmoddi4 too: even when the public div/mod helpers are excluded, libgcc2
# still builds the standalone unsigned DImode core object unless it is named
# explicitly here.  Exclude the generic unsigned SImode helpers too, because
# the merged bare-runtime block provides public __udivsi3/__umodsi3 symbols.

# libgcc2.c __main assumes hosted EH/ctor frame registration.  The bare
# PDP-10 runtime supplies a no-op __main in libgcc1.s instead.

# libgcc2.c emits L_exit only when NEED_ATEXIT is defined.  The freestanding
# PDP-10 target does not define it, so requesting _exit produces an empty
# assembly file, which DAS correctly refuses as an empty image.

# Build the merged PDP-10 assembly runtime through GCC's libgcc1
# mechanism so libgcc1.s is preprocessed and only the selected
# PDP-10 bare-runtime block is assembled.  Do not list libgcc1.s
# in LIB2FUNCS_EXTRA: that assembles the whole preprocessor-driven
# file and exposes duplicate local labels from disabled sections.
LIB1ASMSRC = pdp10/libgcc1.s
LIB1ASMFUNCS = pdp10_bare_runtime

# DAS does not recognize GNU assembler-style CPP line markers.
# Suppress them only for preprocessed libgcc assembly sources.
LIB1ASM_CFLAGS = -Wp,-P

# Provide a real public abort symbol for freestanding pdp10-dec-none users.
LIB2FUNCS_EXTRA = $(srcdir)/config/pdp10/abort.asm

# No EH unwinder objects for the C-only bare target yet.
LIB2ADDEH =
LIB2ADDEHDEP =
