then :
  withval=$with_slibdir; slibdir="$with_slibdir"
else case e in #(
  e) if test "${enable_version_specific_runtime_libs+set}" = set; then
  slibdir='$(libsubdir)'
elif test "$host" != "$target"; then
  slibdir='$(build_tooldir)/lib'
else
  slibdir='$(libdir)'
fi ;;
esac
fi



