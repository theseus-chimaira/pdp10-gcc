/* end confdefs.h.  */
#include <stdio.h>

int main()
{
  char buf[64];
  char *p = buf, *q = NULL;
  sprintf(buf, "%p", p);
  sscanf(buf, "%p", &q);
  return (p != q);
}
_ACEOF
if ac_fn_c_try_run "$LINENO"
then :
  gcc_cv_func_printf_ptr=yes
else case e in #(
  e) gcc_cv_func_printf_ptr=no ;;
esac
fi
rm -f core *.core core.conftest.* gmon.out bb.out conftest$ac_exeext \
  conftest.$ac_objext conftest.beam conftest.$ac_ext ;;
esac
fi

rm -f core core.* *.core ;;
esac
fi
{ printf "%s\n" "$as_me:${as_lineno-$LINENO}: result: $gcc_cv_func_printf_ptr" >&5
printf "%s\n" "$gcc_cv_func_printf_ptr" >&6; }
if test $gcc_cv_func_printf_ptr = yes ; then

printf "%s\n" "#define HAVE_PRINTF_PTR 1" >>confdefs.h

fi


