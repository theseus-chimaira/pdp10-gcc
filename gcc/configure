	    fi
	 ;;
esac
fi
{ printf "%s\n" "$as_me:${as_lineno-$LINENO}: result: $gcc_cv_as_offsetable_lo10" >&5
printf "%s\n" "$gcc_cv_as_offsetable_lo10" >&6; }
	if test "x$gcc_cv_as_offsetable_lo10" = xyes; then

printf "%s\n" "#define HAVE_AS_OFFSETABLE_LO10 1" >>confdefs.h

	fi
    fi

    ;;

  i[34567]86-*-* | x86_64-*-*)
    { printf "%s\n" "$as_me:${as_lineno-$LINENO}: checking assembler instructions" >&5
printf %s "checking assembler instructions... " >&6; }
    gcc_cv_as_instructions=
    if test x$gcc_cv_gas_major_version != x -a x$gcc_cv_gas_minor_version != x; then
      if test "$gcc_cv_gas_major_version" -eq 2 -a "$gcc_cv_gas_minor_version" -ge 9 -o "$gcc_cv_gas_major_version" -gt 2; then
	gcc_cv_as_instructions="filds fists"
      fi
    elif test x$gcc_cv_as != x; then
	set "filds fists" "filds mem; fists mem"
	while test $# -gt 0
  	do
