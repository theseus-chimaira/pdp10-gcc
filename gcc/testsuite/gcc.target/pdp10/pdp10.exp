# PDP-10 GCC-target code-generation checks.
#
# Keep target-specific GCC assertions here instead of duplicating their
# sources in the cross-compiler PDP-10 testkit.  The bare-link and 71/72-bit
# mode-macro probes have dedicated shell drivers and are not standalone
# DejaGNU compile cases.

if {![istarget "pdp10-*-*"]} {
    return
}

load_lib gcc-dg.exp

global DEFAULT_CFLAGS
if {![info exists DEFAULT_CFLAGS]} {
    set DEFAULT_CFLAGS ""
}

dg-init

set tests {}
foreach src [lsort [glob -nocomplain $srcdir/$subdir/*.c]] {
    set name [file tail $src]
    if {[string equal $name "bare-dlink-libgcc-1.c"] ||
        [string equal $name "wide-int-mode-macros.c"]} {
        continue
    }
    lappend tests $src
}

dg-runtest $tests "" $DEFAULT_CFLAGS

dg-finish
